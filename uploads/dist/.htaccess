# GPS — gpsouth.org
Options -Indexes
DirectoryIndex index.html
AddType video/webm .webm

# Single canonical host: https://gpsouth.org (no http, no www)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://gpsouth.org%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.gpsouth\.org$ [NC]
RewriteRule ^ https://gpsouth.org%{REQUEST_URI} [L,R=301]

RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://gpsouth.org/ [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate, max-age=0"
Header unset Expires
</FilesMatch>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType video/webm "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

ErrorDocument 404 /index.html
