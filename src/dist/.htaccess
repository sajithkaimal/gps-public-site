# GPS — gpsouth.org
Options -Indexes
DirectoryIndex index.html
# Keep /about (no trailing slash) working when /about/ is a real directory
DirectorySlash Off
AddType video/webm .webm
AddType image/vnd.microsoft.icon .ico
AddType image/png .png

<IfModule mod_rewrite.c>
RewriteEngine On

# Favicons stay on the requested host (www or apex) with HTTP 200 —
# Google's favicon crawler often does not follow host redirects.
RewriteCond %{REQUEST_URI} !^/(favicon\.(ico|png)|assets/favicon|assets/apple-touch-icon) [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://gpsouth.org%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_URI} !^/(favicon\.(ico|png)|assets/favicon|assets/apple-touch-icon) [NC]
RewriteCond %{HTTP_HOST} ^www\.gpsouth\.org$ [NC]
RewriteRule ^ https://gpsouth.org%{REQUEST_URI} [L,R=301]

# Canonical: strip index.html → /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Canonical: /about/index.html or /about/ → /about
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1 [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([^?\s]+)/\s [NC]
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Canonical: strip .html from public page URLs (keep query string)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Old Partner Institutions URL → combined Partners page
RewriteRule ^network-institutions/?$ /network-partners [R=301,L]

# Internal: /about → /about/index.html (folder pages; works with Live Server + Apache)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Legacy fallback: /about → /about.html if a flat file still exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate, max-age=0"
Header unset Expires
</FilesMatch>
# Harden any Set-Cookie the server may emit (forms, hosting panels, etc.)
# Only rewrite when a Set-Cookie header is present.
Header edit Set-Cookie ^(.*)$ "$1; Secure; HttpOnly; SameSite=Lax"
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType video/webm "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

ErrorDocument 404 /404.html
